PORT=4000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/soilmate?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173
NASA_FEATURE=false
ATTEMPT_TTL_DAYS=7

# SoilMate
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_DEFAULT=1d
JWT_EXPIRES_REMEMBER=30d
BCRYPT_COST=12
PUBLIC_BASE_URL=http://localhost:4000
SCORING_MODE=mock
PYTHON_TIMEOUT_MS=5000
LAYER_DATA_DIR=src/data/layers
# PYTHON_URL=http://localhost:8000   (required only if SCORING_MODE=python)
# In production, set PUBLIC_BASE_URL to your real API address, e.g. https://api.soilmate.app